<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Backroad Arcade</title>
<style>
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(135deg,#101820,#263b32);color:#f5f5f5;min-height:100vh}
header{padding:34px 20px;text-align:center;background:#0b1117;border-bottom:3px solid #d28b32}
h1{margin:0;font-size:clamp(2rem,6vw,3.4rem);letter-spacing:2px}header p{color:#c9d2d8}
main{max-width:980px;margin:28px auto;padding:0 18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:#17232b;border:1px solid #42515a;border-radius:14px;padding:20px;box-shadow:0 8px 24px #0005}
a.btn,button{display:inline-block;background:#d28b32;color:#101820;text-decoration:none;font-weight:bold;padding:12px 16px;border:0;border-radius:8px;cursor:pointer}
input{width:100%;padding:13px;border-radius:8px;border:1px solid #667;background:#0d151b;color:white;margin:8px 0 12px}
.note{color:#b9c4ca;font-size:.9rem;line-height:1.5}iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:10px;background:#000}
</style>
</head>
<body>
<header><h1>BACKROAD ARCADE</h1><p>Games • Videos • Search</p></header>
<main>
<div class="grid">
<section class="card"><h2>Roblox</h2><p>Open Roblox or Roblox Studio.</p><a class="btn" href="https://www.roblox.com/" target="_blank" rel="noopener">Open Roblox</a></section>
<section class="card"><h2>Roblox Studio</h2><p>Create and work on your games.</p><a class="btn" href="https://create.roblox.com/" target="_blank" rel="noopener">Open Studio</a></section>
<section class="card"><h2>DuckDuckGo Search</h2><form action="https://duckduckgo.com/" method="get" target="_blank"><input name="q" placeholder="Search the web"><button type="submit">Search</button></form><p class="note">Opens DuckDuckGo normally; this is not a proxy or school-filter bypass.</p></section>
</div>
<section class="card" style="margin-top:18px"><h2>YouTube</h2><p>Open YouTube in a new tab:</p><a class="btn" href="https://www.youtube.com/" target="_blank" rel="noopener">Open YouTube</a><p class="note">Embedded videos and external sites may be restricted by your school network.</p></section>
</main>
</body></html>
